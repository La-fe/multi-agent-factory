#!/usr/bin/env bash
# Install git hooks from git-hooks/ into .git/hooks/
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
HOOKS_DIR="$ROOT_DIR/git-hooks"

# Support both regular repos and worktrees
# In a worktree, .git is a file pointing to the main repo's worktree dir
GIT_DIR="$(git rev-parse --git-dir 2>/dev/null)"
GIT_HOOKS_DIR="$GIT_DIR/hooks"

if [ ! -d "$GIT_DIR" ]; then
  echo "Error: git directory not found. Are you in a git repo?" >&2
  exit 1
fi

mkdir -p "$GIT_HOOKS_DIR"

for hook in "$HOOKS_DIR"/*; do
  hook_name=$(basename "$hook")
  target="$GIT_HOOKS_DIR/$hook_name"
  cp "$hook" "$target"
  chmod +x "$target"
  echo "Installed: $hook_name"
done

echo "All git hooks installed."
