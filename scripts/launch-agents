#!/usr/bin/env bash
set -euo pipefail

# ─── Visual Multi-Agent Launcher ───────────────────────────────────────
# Launches parallel Claude agents in iTerm2 tabs/splits or tmux panes,
# so you can watch each agent work in real-time.
#
# This is the "visual mode" counterpart to scripts/orchestrator (headless).
#
# Usage:
#   scripts/launch-agents --issues 2 3 4              # specific issues
#   scripts/launch-agents --label status:ready         # by label
#   scripts/launch-agents --issues 2 3 --mode split    # iTerm2 splits
#   scripts/launch-agents --issues 2 3 --mode tmux     # tmux session
#   scripts/launch-agents --issues 2 3 --interactive   # interactive claude (not -p)
#
# Requires: gh, jq, claude CLI
#           iTerm2 (for tab/split modes) or tmux (for tmux mode)
# ────────────────────────────────────────────────────────────────────────

REPO_ROOT="$(git rev-parse --show-toplevel)"
WORKTREE_DIR="${REPO_ROOT}/.worktrees"
WORKER_PROMPT_FILE="${REPO_ROOT}/.claude/agents/worker.md"

# Temp file for issue data (bash 3 compatible — no associative arrays)
ISSUE_DB=$(mktemp)
echo '[]' > "$ISSUE_DB"
trap 'rm -f "$ISSUE_DB"' EXIT

# ─── Defaults ───────────────────────────────────────────────────────────

MODE="tab"           # tab | split | tmux
ISSUES=()
LABEL=""
LIMIT=5
MODEL="sonnet"
BUDGET="2.00"
BASE_BRANCH="main"
INTERACTIVE=false
DRY_RUN=false
TMUX_SESSION="agents"

# ─── Colors ─────────────────────────────────────────────────────────────

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# ─── Helpers ────────────────────────────────────────────────────────────

# Get a field from the issue DB by issue number
iget() {
  local num="$1" field="$2"
  jq -r --argjson n "$num" '.[] | select(.num == $n) | .'"$field" "$ISSUE_DB"
}

# Add an issue to the DB
iadd() {
  local num="$1" title="$2" body="$3" branch="$4"
  local tmp
  tmp=$(mktemp)
  jq --argjson n "$num" --arg t "$title" --arg b "$body" --arg br "$branch" \
    '. + [{num: $n, title: $t, body: $b, branch: $br}]' "$ISSUE_DB" > "$tmp" \
    && mv "$tmp" "$ISSUE_DB"
}

# Generate a short slug from issue title
title_to_slug() {
  local title="$1"
  echo "$title" \
    | sed -E 's/^\[(Bug|Feature|Feat|Fix|Refactor|Docs|Chore)\]:? *//i' \
    | sed -E 's/^(feat|fix|refactor|docs|test|chore)(\([^)]*\))?:? *//i' \
    | tr '[:upper:]' '[:lower:]' \
    | tr -cs 'a-z0-9' '-' \
    | sed 's/^-//;s/-$//' \
    | cut -c1-40 \
    | sed 's/-$//'
}

branch_for_issue() {
  local issue_num="$1"
  local labels="$2"
  local title="${3:-}"
  local prefix="fix"
  if echo "$labels" | grep -qi "enhancement\|feature\|feat"; then
    prefix="feat"
  elif echo "$labels" | grep -qi "refactor"; then
    prefix="refactor"
  elif echo "$labels" | grep -qi "docs\|documentation"; then
    prefix="docs"
  elif echo "$labels" | grep -qi "test"; then
    prefix="test"
  elif echo "$labels" | grep -qi "chore"; then
    prefix="chore"
  fi

  local slug=""
  if [[ -n "$title" ]]; then
    slug=$(title_to_slug "$title")
  fi

  if [[ -n "$slug" ]]; then
    echo "${prefix}/agent-${issue_num}-${slug}"
  else
    echo "${prefix}/agent-${issue_num}"
  fi
}

# ─── Usage ──────────────────────────────────────────────────────────────

usage() {
  cat <<'EOF'
Visual Multi-Agent Launcher — Watch agents work in real-time

Usage:
  scripts/launch-agents --issues 2 3 4 [options]
  scripts/launch-agents --label status:ready [options]

Source (pick one):
  --issues <n...>        Specific issue numbers
  --label <label>        Fetch issues by label

Display modes:
  --mode tab             iTerm2 tabs — each agent in its own tab (default)
  --mode split           iTerm2 vertical splits — side by side
  --mode tmux            tmux session with panes (SSH-friendly, detachable)
  --mode hybrid          tmux backend + iTerm2 tabs (session groups)
  --mode iterm-tmux      iTerm2 native tmux integration (tmux -CC, recommended)

Options:
  --model <model>        Claude model (default: sonnet)
  --budget <usd>         Max budget per agent (default: 2.00)
  --base <branch>        Base branch (default: main)
  --limit <n>            Max issues when using --label (default: 5)
  --interactive          Launch interactive claude (not headless -p)
  --dry-run              Show what would be launched
  --session <name>       tmux session name (default: agents)
  -h, --help             Show this help

Examples:
  # Launch 3 agents in iTerm2 tabs
  scripts/launch-agents --issues 2 3 4

  # Launch by label in iTerm2 splits (side by side)
  scripts/launch-agents --label "status:ready" --mode split

  # Launch in tmux (SSH-friendly)
  scripts/launch-agents --issues 2 3 --mode tmux

  # Hybrid: tmux backend + iTerm2 tabs (session groups)
  scripts/launch-agents --issues 2 3 4 --mode hybrid

  # iTerm2 native tmux integration (recommended — auto splits, native tabs)
  scripts/launch-agents --issues 2 3 4 --mode iterm-tmux

  # Interactive mode — you chat with each agent
  scripts/launch-agents --issues 2 --mode tab --interactive
EOF
  exit 0
}

# ─── Parse Args ─────────────────────────────────────────────────────────

while [[ $# -gt 0 ]]; do
  case "$1" in
    --issues)
      shift
      while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do
        ISSUES+=("$1"); shift
      done
      ;;
    --label)      LABEL="$2"; shift 2 ;;
    --mode)       MODE="$2"; shift 2 ;;
    --model)      MODEL="$2"; shift 2 ;;
    --budget)     BUDGET="$2"; shift 2 ;;
    --base)       BASE_BRANCH="$2"; shift 2 ;;
    --limit)      LIMIT="$2"; shift 2 ;;
    --interactive) INTERACTIVE=true; shift ;;
    --dry-run)    DRY_RUN=true; shift ;;
    --session)    TMUX_SESSION="$2"; shift 2 ;;
    -h|--help)    usage ;;
    *)            echo "Unknown option: $1" >&2; usage ;;
  esac
done

if [[ ${#ISSUES[@]} -eq 0 && -z "$LABEL" ]]; then
  echo -e "${RED}ERROR: Specify --issues or --label${NC}" >&2
  usage
fi

# ─── Preflight ──────────────────────────────────────────────────────────

for tool in gh jq claude; do
  if ! command -v "$tool" &>/dev/null; then
    echo -e "${RED}ERROR: '$tool' is not installed${NC}" >&2
    exit 1
  fi
done

if [[ "$MODE" == "tab" || "$MODE" == "split" || "$MODE" == "hybrid" ]]; then
  if ! osascript -e 'tell application "iTerm2" to name of current window' &>/dev/null; then
    echo -e "${YELLOW}WARNING: iTerm2 not running or not accessible. Falling back to tmux.${NC}"
    MODE="tmux"
  fi
fi

if [[ "$MODE" == "tmux" || "$MODE" == "hybrid" || "$MODE" == "iterm-tmux" ]]; then
  if ! command -v tmux &>/dev/null; then
    echo -e "${RED}ERROR: tmux is not installed${NC}" >&2
    exit 1
  fi
fi

if [[ "$MODE" == "iterm-tmux" ]]; then
  if ! osascript -e 'tell application "iTerm2" to name of current window' &>/dev/null; then
    echo -e "${RED}ERROR: iTerm2 is not running (required for iterm-tmux mode)${NC}" >&2
    exit 1
  fi
fi

# ─── Fetch Issues ───────────────────────────────────────────────────────

echo -e "${BOLD}═══ Visual Agent Launcher ═══${NC}"
echo ""

if [[ -n "$LABEL" ]]; then
  echo -e "${BLUE}→ Fetching issues (label: ${LABEL}, limit: ${LIMIT})${NC}"
  ISSUES_JSON=$(gh issue list --state open --label "$LABEL" --limit "$LIMIT" \
    --json number,title,body,labels)
  ISSUE_COUNT=$(echo "$ISSUES_JSON" | jq 'length')

  if [[ "$ISSUE_COUNT" -eq 0 ]]; then
    echo -e "${YELLOW}No issues found with label '${LABEL}'${NC}"
    exit 0
  fi

  ISSUES=()
  for i in $(seq 0 $((ISSUE_COUNT - 1))); do
    NUM=$(echo "$ISSUES_JSON" | jq -r ".[$i].number")
    TITLE=$(echo "$ISSUES_JSON" | jq -r ".[$i].title")
    BODY=$(echo "$ISSUES_JSON" | jq -r ".[$i].body // \"No description.\"")
    LABELS_STR=$(echo "$ISSUES_JSON" | jq -r ".[$i].labels | map(.name) | join(\",\")")
    BRANCH=$(branch_for_issue "$NUM" "$LABELS_STR" "$TITLE")
    ISSUES+=("$NUM")
    iadd "$NUM" "$TITLE" "$BODY" "$BRANCH"
  done
else
  echo -e "${BLUE}→ Fetching issue details...${NC}"
  for num in "${ISSUES[@]}"; do
    ISSUE_DATA=$(gh issue view "$num" --json number,title,body,labels 2>/dev/null || echo '{}')
    if [[ $(echo "$ISSUE_DATA" | jq 'has("number")') != "true" ]]; then
      echo -e "${RED}ERROR: Issue #${num} not found${NC}" >&2
      exit 1
    fi
    TITLE=$(echo "$ISSUE_DATA" | jq -r '.title')
    BODY=$(echo "$ISSUE_DATA" | jq -r '.body // "No description."')
    LABELS_STR=$(echo "$ISSUE_DATA" | jq -r '.labels | map(.name) | join(",")')
    BRANCH=$(branch_for_issue "$num" "$LABELS_STR" "$TITLE")
    iadd "$num" "$TITLE" "$BODY" "$BRANCH"
  done
fi

# ─── Display Plan ───────────────────────────────────────────────────────

echo ""
echo -e "${BOLD}Agents to launch:${NC}"
echo "┌──────┬──────────────────────────────────┬────────────────────────┐"
printf "│ %-4s │ %-32s │ %-22s │\n" "#" "Title" "Branch"
echo "├──────┼──────────────────────────────────┼────────────────────────┤"
for num in "${ISSUES[@]}"; do
  TITLE=$(iget "$num" "title")
  BRANCH=$(iget "$num" "branch")
  if [[ ${#TITLE} -gt 30 ]]; then TITLE="${TITLE:0:27}..."; fi
  if [[ ${#BRANCH} -gt 20 ]]; then BRANCH="${BRANCH:0:17}..."; fi
  printf "│ %-4s │ %-32s │ %-22s │\n" "$num" "$TITLE" "$BRANCH"
done
echo "└──────┴──────────────────────────────────┴────────────────────────┘"
echo ""
echo -e "  Mode: ${CYAN}${MODE}${NC} | Model: ${MODEL} | Budget: \$${BUDGET}/agent"
echo ""

if [[ "$DRY_RUN" == true ]]; then
  echo -e "${CYAN}[DRY RUN] Would launch ${#ISSUES[@]} agent(s) in ${MODE} mode${NC}"
  exit 0
fi

# ─── Pre-check: Clean Old Branches ────────────────────────────────────
# When re-running agents for the same issues, old remote branches cause
# push conflicts. Clean them up first.
# Safety: only agent-prefixed branches are cleaned; unpushed commits block deletion.

echo -e "${BLUE}→ Pre-check: cleaning stale branches...${NC}"

for num in "${ISSUES[@]}"; do
  BRANCH=$(iget "$num" "branch")
  WT_PATH="${WORKTREE_DIR}/${BRANCH}"

  # Safety check 1: only process agent-/issue- prefixed branches
  if [[ "$BRANCH" != *"/agent-"* ]] && [[ "$BRANCH" != *"/issue-"* ]]; then
    echo -e "  ${YELLOW}Skipping non-agent branch: ${BRANCH}${NC}"
    continue
  fi

  # Safety check 2: unpushed commit protection
  if git show-ref --verify --quiet "refs/heads/${BRANCH}" 2>/dev/null; then
    UNPUSHED=$(git log "origin/${BRANCH}..${BRANCH}" --oneline 2>/dev/null | wc -l | tr -d ' ')
    if [[ "$UNPUSHED" -gt 0 ]]; then
      echo -e "  ${RED}WARNING: ${BRANCH} has ${UNPUSHED} unpushed commit(s) — skipping${NC}"
      continue
    fi
  fi

  # Remove existing worktree
  if [[ -d "$WT_PATH" ]]; then
    git worktree remove "$WT_PATH" --force 2>/dev/null || true
    echo -e "  ${DIM}Removed old worktree: ${BRANCH}${NC}"
  fi

  # Delete local branch if exists
  if ! git branch -D "$BRANCH" 2>/dev/null; then
    git update-ref -d "refs/heads/${BRANCH}" 2>/dev/null || true
  fi
  echo -e "  ${DIM}Deleted local branch: ${BRANCH}${NC}"

  # Delete remote branch if exists
  if git ls-remote --heads origin "$BRANCH" 2>/dev/null | grep -q "$BRANCH"; then
    git push origin --delete "$BRANCH" 2>/dev/null && \
      echo -e "  ${DIM}Deleted remote branch: ${BRANCH}${NC}" || true
  fi

  # Close old PR if exists
  old_pr=$(gh pr list --state open --head "$BRANCH" --json number --jq '.[0].number' 2>/dev/null || echo "")
  if [[ -n "$old_pr" ]]; then
    gh pr close "$old_pr" --delete-branch 2>/dev/null && \
      echo -e "  ${DIM}Closed old PR #${old_pr}${NC}" || true
  fi
done

echo ""

# ─── Create Worktrees ───────────────────────────────────────────────────

echo -e "${BLUE}→ Creating worktrees...${NC}"

for num in "${ISSUES[@]}"; do
  BRANCH=$(iget "$num" "branch")
  WT_PATH="${WORKTREE_DIR}/${BRANCH}"

  if [[ -d "$WT_PATH" ]]; then
    echo -e "  ${YELLOW}⊘ #${num}: Worktree exists, reusing${NC}"
  else
    if bash "${REPO_ROOT}/scripts/create-worktree" "$BRANCH" "$BASE_BRANCH" >/dev/null 2>&1; then
      echo -e "  ${GREEN}✓ #${num}: ${WT_PATH}${NC}"
    else
      echo -e "  ${RED}✗ #${num}: Failed to create worktree${NC}"
      exit 1
    fi
  fi

  # Transition label: status:ready → status:in-progress
  gh issue edit "$num" --remove-label "status:ready" --add-label "status:in-progress" 2>/dev/null || true
done

# ─── Build Agent Commands ───────────────────────────────────────────────

WORKER_PROMPT_BASE=""
if [[ -f "$WORKER_PROMPT_FILE" ]]; then
  # Strip YAML frontmatter (--- ... ---) to prevent claude -p from
  # interpreting leading '---' as a command-line flag
  WORKER_PROMPT_BASE=$(sed '/^---$/,/^---$/d' "$WORKER_PROMPT_FILE")
fi

# Store commands in temp files (one per issue, bash 3 compatible)
CMD_DIR=$(mktemp -d)

for num in "${ISSUES[@]}"; do
  BRANCH=$(iget "$num" "branch")
  WT_PATH="${WORKTREE_DIR}/${BRANCH}"
  TITLE=$(iget "$num" "title")
  BODY=$(iget "$num" "body")

  # Write the prompt to a file in the worktree
  PROMPT_FILE="${WT_PATH}/.agent-prompt.md"
  cat > "$PROMPT_FILE" <<PROMPT
${WORKER_PROMPT_BASE}

---

## Your Assignment

**Issue #${num}: ${TITLE}**

${BODY}

## Important Context

- You are working in worktree: ${WT_PATH}
- Your branch: ${BRANCH}
- Base branch: ${BASE_BRANCH}
- Create a PR that references: fixes #${num}
- Follow ALL rules in AGENTS.md
PROMPT

  # Write a launcher script into the worktree
  # Must unset ALL Claude env vars to avoid nested-instance detection
  #
  # Visual modes (tab/split/hybrid/iterm-tmux): use INTERACTIVE claude with
  # --dangerously-skip-permissions so the full TUI is visible (tool calls,
  # file reads, progress). A short initial prompt tells Claude to read the
  # task file. This lets users WATCH the agent work in real-time.
  #
  # Headless mode (tmux): use claude -p for silent background execution.
  LAUNCHER_FILE="${WT_PATH}/.agent-launcher.sh"
  is_visual=false
  if [[ "$MODE" == "tab" || "$MODE" == "split" || "$MODE" == "hybrid" || "$MODE" == "iterm-tmux" ]]; then
    is_visual=true
  fi

  if [[ "$INTERACTIVE" == true ]]; then
    # Fully interactive — user chats with the agent
    cat > "$LAUNCHER_FILE" <<EOF
#!/usr/bin/env bash
cd '${WT_PATH}'
unset CLAUDECODE CLAUDE_CODE_ENTRYPOINT
exec claude --dangerously-skip-permissions --model ${MODEL}
EOF
  elif [[ "$is_visual" == true ]]; then
    # Visual auto mode — interactive TUI so user can watch agent work.
    # Pass initial message to start the task; Claude reads the prompt file.
    cat > "$LAUNCHER_FILE" <<EOF
#!/usr/bin/env bash
cd '${WT_PATH}'
unset CLAUDECODE CLAUDE_CODE_ENTRYPOINT
exec claude --dangerously-skip-permissions --model ${MODEL} --max-budget-usd ${BUDGET} "Read the file .agent-prompt.md and follow ALL instructions in it. Complete the assigned issue end-to-end: analyze, implement, test, commit, push, and create PR."
EOF
  else
    # Headless mode — silent background execution (tmux panes)
    cat > "$LAUNCHER_FILE" <<EOF
#!/usr/bin/env bash
cd '${WT_PATH}'
unset CLAUDECODE CLAUDE_CODE_ENTRYPOINT
PROMPT=\$(cat .agent-prompt.md)
exec claude -p --dangerously-skip-permissions --model ${MODEL} --max-budget-usd ${BUDGET} -- "\$PROMPT"
EOF
  fi
  chmod +x "$LAUNCHER_FILE"
  echo "bash '${LAUNCHER_FILE}'" > "${CMD_DIR}/${num}"
done

# ─── Launch: iTerm2 Tab Mode ───────────────────────────────────────────
# Creates a NEW WINDOW with one tab per agent (doesn't use current session)

launch_iterm_tabs() {
  local applescript=""

  applescript='tell application "iTerm2"
  activate
  set newWin to (create window with default profile)
  tell newWin
'

  local first=true
  for num in "${ISSUES[@]}"; do
    local cmd
    cmd=$(cat "${CMD_DIR}/${num}")
    local title="Agent #${num}"
    cmd="${cmd//\\/\\\\}"
    cmd="${cmd//\"/\\\"}"

    if [[ "$first" == true ]]; then
      applescript="${applescript}
    tell current session
      set name to \"${title}\"
      write text \"${cmd}\"
    end tell
"
      first=false
    else
      applescript="${applescript}
    set newTab to (create tab with default profile)
    tell current session of newTab
      set name to \"${title}\"
      write text \"${cmd}\"
    end tell
"
    fi
  done

  applescript="${applescript}
  end tell
end tell"

  osascript -e "$applescript"
}

# ─── Launch: iTerm2 Split Mode ─────────────────────────────────────────
# Creates a NEW WINDOW and splits it vertically — one pane per agent

launch_iterm_splits() {
  local applescript=""

  applescript='tell application "iTerm2"
  activate
  set newWin to (create window with default profile)
  tell newWin
    tell current session
'

  local first=true
  for num in "${ISSUES[@]}"; do
    local cmd
    cmd=$(cat "${CMD_DIR}/${num}")
    local title="Agent #${num}"
    cmd="${cmd//\\/\\\\}"
    cmd="${cmd//\"/\\\"}"

    if [[ "$first" == true ]]; then
      applescript="${applescript}
      set name to \"${title}\"
      write text \"${cmd}\"
"
      first=false
    else
      applescript="${applescript}
    end tell
    tell current session
      set newPane to (split vertically with default profile)
    end tell
    tell newPane
      set name to \"${title}\"
      write text \"${cmd}\"
"
    fi
  done

  applescript="${applescript}
    end tell
  end tell
end tell"

  osascript -e "$applescript"
}

# ─── Launch: tmux Mode ─────────────────────────────────────────────────

launch_tmux() {
  # Kill existing session if present
  tmux kill-session -t "$TMUX_SESSION" 2>/dev/null || true

  local first=true

  for num in "${ISSUES[@]}"; do
    local cmd
    cmd=$(cat "${CMD_DIR}/${num}")

    if [[ "$first" == true ]]; then
      tmux new-session -d -s "$TMUX_SESSION" -n "agent-${num}"
      tmux send-keys -t "$TMUX_SESSION" "$cmd" Enter
      first=false
    else
      tmux split-window -h -t "$TMUX_SESSION"
      tmux send-keys "$cmd" Enter
    fi
  done

  # Even out the layout
  tmux select-layout -t "$TMUX_SESSION" even-horizontal 2>/dev/null || true

  echo ""
  echo -e "${GREEN}✓ tmux session '${TMUX_SESSION}' created with ${#ISSUES[@]} pane(s)${NC}"
  echo ""
  echo "  Attach:   tmux attach -t ${TMUX_SESSION}"
  echo "  Monitor:  tmux list-panes -t ${TMUX_SESSION}"
  echo "  Kill:     tmux kill-session -t ${TMUX_SESSION}"
  echo ""

  # Auto-attach if we're in an interactive terminal
  if [[ -t 0 ]]; then
    read -rp "Attach now? [Y/n] " response
    if [[ "$response" != "n" && "$response" != "N" ]]; then
      tmux attach -t "$TMUX_SESSION"
    fi
  fi
}

# ─── Launch: Hybrid Mode (tmux backend + iTerm2 tabs) ─────────────────
# tmux runs agents in separate WINDOWS → iTerm2 tabs via SESSION GROUPS
# Session groups let each tab view a different window independently.

launch_hybrid() {
  # Step 1: Create tmux session with one WINDOW per agent
  tmux kill-session -t "$TMUX_SESSION" 2>/dev/null || true

  local idx=0
  for num in "${ISSUES[@]}"; do
    local cmd
    cmd=$(cat "${CMD_DIR}/${num}")

    if [[ $idx -eq 0 ]]; then
      tmux new-session -d -s "$TMUX_SESSION" -n "agent-${num}"
      tmux send-keys -t "${TMUX_SESSION}:0" "$cmd" Enter
    else
      tmux new-window -t "$TMUX_SESSION" -n "agent-${num}"
      tmux send-keys -t "${TMUX_SESSION}:${idx}" "$cmd" Enter
    fi
    idx=$((idx + 1))
  done

  echo ""
  echo -e "${GREEN}✓ tmux session '${TMUX_SESSION}' created with ${#ISSUES[@]} window(s)${NC}"

  # Step 2: Open iTerm2 tabs, each using a tmux SESSION GROUP
  # Session groups share windows but each has its own "current window" —
  # this prevents the bug where all tabs show the same window.
  local applescript='tell application "iTerm2"
  activate
  tell current window
'
  local first=true
  idx=0

  for num in "${ISSUES[@]}"; do
    local view_session="view-agent-${num}"
    # Create a session group member and select the right window
    tmux new-session -d -t "$TMUX_SESSION" -s "$view_session"
    tmux select-window -t "${view_session}:agent-${num}"

    local attach_cmd="tmux attach -t ${view_session}"
    local title="Agent #${num}"
    attach_cmd="${attach_cmd//\\/\\\\}"
    attach_cmd="${attach_cmd//\"/\\\"}"

    if [[ "$first" == true ]]; then
      applescript="${applescript}
    tell current session
      set name to \"${title}\"
      write text \"${attach_cmd}\"
    end tell
"
      first=false
    else
      applescript="${applescript}
    set newTab to (create tab with default profile)
    tell current session of newTab
      set name to \"${title}\"
      write text \"${attach_cmd}\"
    end tell
"
    fi
    idx=$((idx + 1))
  done

  applescript="${applescript}
  end tell
end tell"

  osascript -e "$applescript"

  echo ""
  echo -e "${GREEN}✓ iTerm2 tabs connected to tmux windows (via session groups)${NC}"
  echo ""
  echo "  Each iTerm2 tab shows a different agent independently. You get:"
  echo "    - Native iTerm2 rendering + ⌘←→ tab switching"
  echo "    - Each tab locked to its own agent (no shared state)"
  echo "    - tmux backend: detach (Ctrl-b d), agents keep running"
  echo "    - Auto-monitor: scripts/monitor-agents --auto-approve"
  echo ""
  echo "  Reattach a tab:  tmux attach -t view-agent-N"
  echo "  Kill all:        tmux kill-session -t ${TMUX_SESSION}"
}

# ─── Launch: iTerm2 Native tmux Integration (tmux -CC) ───────────────
# Uses iTerm2's built-in tmux integration. One command creates native
# iTerm2 tabs/panes from tmux windows. Simplest and most elegant approach.

launch_iterm_tmux() {
  # Step 1: Create tmux session with one WINDOW per agent
  tmux kill-session -t "$TMUX_SESSION" 2>/dev/null || true

  local idx=0
  for num in "${ISSUES[@]}"; do
    local cmd
    cmd=$(cat "${CMD_DIR}/${num}")

    if [[ $idx -eq 0 ]]; then
      tmux new-session -d -s "$TMUX_SESSION" -n "agent-${num}"
      tmux send-keys -t "${TMUX_SESSION}:0" "$cmd" Enter
    else
      tmux new-window -t "$TMUX_SESSION" -n "agent-${num}"
      tmux send-keys -t "${TMUX_SESSION}:${idx}" "$cmd" Enter
    fi
    idx=$((idx + 1))
  done

  echo ""
  echo -e "${GREEN}✓ tmux session '${TMUX_SESSION}' created with ${#ISSUES[@]} window(s)${NC}"

  # Step 2: Attach with tmux -CC for native iTerm2 integration
  # tmux -CC makes iTerm2 treat each tmux window as a native tab
  echo ""
  echo -e "${CYAN}→ Connecting via iTerm2 native tmux integration...${NC}"
  echo ""
  echo "  Each tmux window will appear as a native iTerm2 tab."
  echo "  Switch agents: ⌘←→ (tabs)"
  echo "  Detach: close the tmux dashboard window"
  echo "  Reattach: tmux -CC attach -t ${TMUX_SESSION}"
  echo "  Kill all: tmux kill-session -t ${TMUX_SESSION}"
  echo ""

  # Launch via AppleScript so it opens in iTerm2 (not the current terminal)
  osascript -e "
tell application \"iTerm2\"
  activate
  tell current window
    tell current session
      write text \"tmux -CC attach -t ${TMUX_SESSION}\"
    end tell
  end tell
end tell
"

  echo -e "${GREEN}✓ iTerm2 native tmux integration active${NC}"
  echo "  Auto-monitor: scripts/monitor-agents --auto-approve"
}

# ─── Dispatch ───────────────────────────────────────────────────────────

echo -e "${BLUE}→ Launching ${#ISSUES[@]} agent(s) in ${MODE} mode...${NC}"

case "$MODE" in
  tab)        launch_iterm_tabs ;;
  split)      launch_iterm_splits ;;
  tmux)       launch_tmux ;;
  hybrid)     launch_hybrid ;;
  iterm-tmux) launch_iterm_tmux ;;
  *)
    echo -e "${RED}Unknown mode: ${MODE}. Use tab, split, tmux, hybrid, or iterm-tmux.${NC}" >&2
    exit 1
    ;;
esac

# Clean up command temp dir
rm -rf "$CMD_DIR"

echo ""
echo -e "${GREEN}✓ ${#ISSUES[@]} agent(s) launched in ${MODE} mode${NC}"
echo ""

if [[ "$MODE" == "tab" || "$MODE" == "split" ]]; then
  echo "  Agents are running in a new iTerm2 window."
  echo "  Switch panes: ⌘← ⌘→ (tabs) or ⌘⌥← ⌘⌥→ (splits)"
fi

echo ""
echo -e "${BLUE}→ Waiting for all agents to complete...${NC}"
echo -e "${DIM}  (this terminal monitors progress; agents run in iTerm2 splits/tabs)${NC}"
echo ""

# ─── Wait & Monitor ──────────────────────────────────────────────────

POLL_INTERVAL=15
MAX_WAIT=600  # 10 minutes
elapsed=0

while [[ $elapsed -lt $MAX_WAIT ]]; do
  sleep "$POLL_INTERVAL"
  elapsed=$((elapsed + POLL_INTERVAL))

  all_done=true
  for num in "${ISSUES[@]}"; do
    BRANCH=$(iget "$num" "branch")
    WT_PATH="${WORKTREE_DIR}/${BRANCH}"
    commits=$(cd "$WT_PATH" 2>/dev/null && git rev-list --count main..HEAD 2>/dev/null || echo "0")
    if [[ "$commits" -eq 0 ]]; then
      all_done=false
    fi
  done

  # Show status line
  timestamp=$(date '+%H:%M:%S')
  echo -ne "\r${DIM}[${timestamp}]${NC} "
  for num in "${ISSUES[@]}"; do
    BRANCH=$(iget "$num" "branch")
    WT_PATH="${WORKTREE_DIR}/${BRANCH}"
    commits=$(cd "$WT_PATH" 2>/dev/null && git rev-list --count main..HEAD 2>/dev/null || echo "0")
    has_remote=$(git ls-remote --heads origin "$BRANCH" 2>/dev/null | wc -l | tr -d ' ')
    if [[ "$has_remote" -gt 0 ]]; then
      echo -ne "${GREEN}#${num}✓${NC} "
    elif [[ "$commits" -gt 0 ]]; then
      echo -ne "${CYAN}#${num}⚙${NC} "
    else
      echo -ne "${YELLOW}#${num}…${NC} "
    fi
  done
  echo ""

  if [[ "$all_done" == true ]]; then
    break
  fi

  # Check if any claude processes still running
  running=$(ps aux | grep '[c]laude.*dangerously.*model' | grep -v "allow-dangerously" | grep -v stream-json | wc -l | tr -d ' ')
  if [[ "$running" -eq 0 && $elapsed -gt 30 ]]; then
    break
  fi
done

# ─── Summary ────────────────────────────────────────────────────────

echo ""
echo -e "${BOLD}═══ Agent Results ═══${NC}"
echo ""

total_ok=0
total_fail=0

for num in "${ISSUES[@]}"; do
  TITLE=$(iget "$num" "title")
  BRANCH=$(iget "$num" "branch")
  WT_PATH="${WORKTREE_DIR}/${BRANCH}"

  commits=$(cd "$WT_PATH" 2>/dev/null && git rev-list --count main..HEAD 2>/dev/null || echo "0")
  last_commit=$(cd "$WT_PATH" 2>/dev/null && git log --oneline -1 2>/dev/null || echo "no commits")
  pr_num=$(gh pr list --state open --head "$BRANCH" --json number --jq '.[0].number' 2>/dev/null || echo "")

  if [[ -n "$pr_num" ]]; then
    echo -e "  ${GREEN}✓${NC} #${num}: ${TITLE}"
    echo -e "    PR #${pr_num} | ${last_commit}"
    total_ok=$((total_ok + 1))
    # Transition label: status:in-progress → status:review
    gh issue edit "$num" --remove-label "status:in-progress" --add-label "status:review" 2>/dev/null || true
  elif [[ "$commits" -gt 0 ]]; then
    echo -e "  ${YELLOW}⚙${NC} #${num}: ${TITLE}"
    echo -e "    Committed but no PR | ${last_commit}"
    total_ok=$((total_ok + 1))
  else
    echo -e "  ${RED}✗${NC} #${num}: ${TITLE}"
    echo -e "    No changes produced"
    total_fail=$((total_fail + 1))
  fi
done

echo ""
echo -e "  ${BOLD}Total: ${#ISSUES[@]}${NC}  ${GREEN}Success: ${total_ok}${NC}  ${RED}Failed: ${total_fail}${NC}"

if [[ $total_ok -gt 0 ]]; then
  echo ""
  echo "  Review PRs:  scripts/review-prs"
fi

echo ""
echo "  Cleanup worktrees:"
for num in "${ISSUES[@]}"; do
  BRANCH=$(iget "$num" "branch")
  echo "    git worktree remove .worktrees/${BRANCH}"
done
echo ""
